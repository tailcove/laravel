{
    "name": "tailcove/laravel",
    "description": "Monolog handler and Laravel service provider for sending application logs to Tailcove.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://tailcove.dev",
    "support": {
        "issues": "https://github.com/tailcove/laravel/issues",
        "source": "https://github.com/tailcove/laravel",
        "docs": "https://tailcove.dev/docs"
    },
    "keywords": ["laravel", "logging", "monolog", "tailcove"],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Tailcove\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tailcove\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tailcove\\Laravel\\TailcoveServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
